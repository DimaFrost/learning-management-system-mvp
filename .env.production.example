# Production frontend environment.
# Copy these values into the Cloudflare Pages Production environment.
# For Vite, only VITE_* variables are exposed to the browser.
VITE_SUPABASE_URL=https://your-production-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-or-publishable-key
VITE_APP_ENV=production
VITE_APP_ENV_LABEL=Production
