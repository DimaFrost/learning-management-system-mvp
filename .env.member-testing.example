# Member Testing frontend environment.
# Copy these values into the Cloudflare Pages Preview/Member Testing environment,
# or into .env.local when you want local development to use Member Testing.
# For Vite, only VITE_* variables are exposed to the browser.
VITE_SUPABASE_URL=https://your-member-test-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-member-testing-anon-or-publishable-key
VITE_APP_ENV=member-testing
VITE_APP_ENV_LABEL=Member Testing
