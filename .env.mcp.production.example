# Production MCP-only Supabase credentials.
# Copy to .env.mcp.local only when intentionally working against Production.
# Do not commit .env.mcp.local or real service-role keys.
MCP_SUPABASE_URL=https://your-production-project-ref.supabase.co
MCP_SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
SUPABASE_DB_PASSWORD=your-production-database-password-for-cli-dumps
